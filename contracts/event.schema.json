{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "问诊前AI意见交接事件信封",
  "type": "object",
  "required": [
    "event_id",
    "kind",
    "occurred_at",
    "subject_id",
    "version",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1,
      "description": "全局唯一事件标识，同一事件流内不得重复"
    },
    "kind": {
      "type": "string",
      "enum": [
        "SUBMISSION_CREATED",
        "MATERIAL_RECEIVED",
        "AI_ANSWER_RECORDED",
        "RISK_FLAG_RAISED",
        "SHARING_CONSENT_GRANTED",
        "MATERIAL_WITHDRAWN",
        "PROXY_AUTHORIZATION_VERIFIED",
        "ADVICE_REVIEW_RECORDED",
        "CLINICAL_PLAN_SIGNED",
        "APPOINTMENT_RESCHEDULED",
        "REFERRAL_CREATED"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "事件发生时间，ISO 8601 且必须带时区"
    },
    "subject_id": {
      "type": "string",
      "minLength": 1,
      "description": "患者主体标识"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "信封 schema 版本"
    },
    "payload": {
      "type": "object",
      "description": "各类事件的载荷，逐类必填与规则见 src/contract.js 的 PAYLOAD_RULES"
    }
  },
  "additionalProperties": true
}
